# Copy to .env (gitignored) and fill in. Variables already set in the shell win over this file.
# TEST MODE ONLY: LiveStripe refuses any key that isn't sk_test_ / rk_test_.

# ---- Required for the server and scripts/testmode_demo.py ----------------------------------
# Stripe Dashboard (test mode) -> Developers -> API keys. A restricted rk_test_ key also works.
STRIPE_SECRET_KEY=sk_test_replace_me
# Stripe Dashboard (test mode) -> Issuing -> Cardholders -> create one, copy its id.
STRIPE_CARDHOLDER_ID=ich_replace_me
# Printed by `stripe listen --events issuing_authorization.request,issuing_authorization.created,issuing_transaction.created --forward-to localhost:8000/webhooks/stripe`
# (stays the same across restarts for the same `stripe login`).
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Only for accounts on Stripe's v2 money management (card creation says "You need a financial
# account"): the fa_... id of an OPEN financial account, sent as financial_account_v2.
# STRIPE_FINANCIAL_ACCOUNT=fa_test_replace_me

# Signing keys. Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SECRET=replace-with-random-hex
SESSION_SECRET=replace-with-random-hex

# Exposes POST /auth/dev-login (mints a session for any name). Development only; the demo needs it.
AGENTPAY_DEV_LOGIN=1

# ---- Optional (defaults shown) ---------------------------------------------------------------
# BASE_URL=http://localhost:8000
# IT_APPROVER=approver_it
# Monthly budget per team, in cents; seeded for this month and next on startup.
# BUDGETS=it=500000
# Vendor allowlist: Vendor=mcc1|mcc2;Other=mcc
# VENDORS=Dell=computer_software_stores
# Vendors that skip the new-vendor review, comma-separated.
# TRUSTED_VENDORS=
# AGENTPAY_DB=agentpay.db
# Stripe-Version header on real-time auth responses; defaults to the installed stripe-python's.
# STRIPE_API_VERSION=

# ---- Live planner / evals --live (optional) -------------------------------------------------
# ANTHROPIC_API_KEY=
# AGENTPAY_PLANNER_MODEL=claude-opus-5-5
